# ─── Vendor Portal — Environment Variables ──────────────────────────────────
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.

# ─── Property Data ───────────────────────────────────────────────────────────

# Absolute path to the properties markdown folder.
# On Railway this should point at the mounted volume path (e.g. /data/properties)
# — see docs/railway-deploy.md in the GEA_ST_vendor_portal repo for the full setup.
# Locally defaults to the iCloud-synced GEA_ST_vendor_portal/properties folder.
PROPERTIES_DIR=/path/to/gea-vendor-portal/properties

# Storage driver for write-heavy JSON sidecars (activity.json, comments.json).
# "fs" (default) writes to PROPERTIES_DIR — correct for local/dev and Railway,
# both of which have a writable disk (Railway via the mounted volume).
# "kv" (STORAGE_DRIVER=kv) is a Vercel-KV driver that was scoped for a
# read-only-FS deploy target; the Railway switch cancelled that work — see
# src/lib/storage.ts's kvDriver, which intentionally still throws. Leave unset.
# STORAGE_DRIVER=fs

# Absolute path to the rentals markdown folder (used by the landlord portal).
# Locally defaults to the iCloud-synced GEA_vendor_portal/rentals folder.
RENTALS_DIR=/path/to/gea-vendor-portal/rentals

# ─── Vendor / Landlord Token Store ───────────────────────────────────────────

# vendor-tokens.ts and rental-tokens.ts read from a JSON file at:
#   src/lib/vendor-tokens.json  (vendor/sales portal)
#   src/lib/rental-tokens.json  (landlord portal)
# These files are gitignored. On Vercel, inject the JSON content via an env var
# and update the loader to read from it, or use Vercel Edge Config instead.
#
# VENDOR_TOKENS_JSON={"tokens":{"<token>":"<slug>"},"meta":{}}
# RENTAL_TOKENS_JSON={"tokens":{"<token>":"<slug>"},"meta":{}}

# ─── Email Notifications (Resend) ────────────────────────────────────────────

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address shown in vendor notification emails.
RESEND_FROM=Grant Estate Agency <portal@grantsea.com.au>

# ─── Public / Base URL ───────────────────────────────────────────────────────

# Production base URL — used to construct vendor portal links.
NEXT_PUBLIC_BASE_URL=https://portal.grantsea.com.au

# ─── Ingest auth (Open Claw / CRM → portal) ──────────────────────────────────

# Shared secret for the machine-to-machine ingest routes:
#   /api/ingest/analytics, /api/ingest/inspection, /api/ingest/telegram,
#   /api/ingest/report-pdf
# The caller (Open Claw / GEA CRM) must send it as the `x-ingest-key` header.
# Verified when set; in production an UNSET key fails closed (503). Local/dev
# leaves the routes open for convenience. Server-side only; never expose.
INGEST_API_KEY=your-ingest-shared-secret

# ─── Agent / Admin Auth ──────────────────────────────────────────────────────

# Single shared secret for agent-only surfaces: the /admin/* pages (via a
# signed session cookie — see /admin/login), /api/properties/create, and all
# /api/agent/* routes. In production an UNSET key fails closed (503 on login,
# 401 via proxy.ts). Use a high-entropy value (>=32 random bytes) — it is now
# also a login credential guessed online, not just a header only scripts see.
# Generate one with: openssl rand -hex 32
AGENT_API_KEY=your-agent-shared-secret

# Where vendor-comment notifications (and other agent-facing alerts) are sent.
AGENT_NOTIFY_EMAIL=agent@grantsea.com.au

# ─── ClickUp Integration ─────────────────────────────────────────────────────

# ClickUp personal API token — https://app.clickup.com/settings
CLICKUP_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HMAC secret configured in the ClickUp webhook itself, used to verify
# /api/ingest/clickup requests actually came from ClickUp. Fails closed
# (503) in production when unset.
CLICKUP_WEBHOOK_SECRET=your-clickup-webhook-secret

# ─── Twilio ───────────────────────────────────────────────────────────────────

# TWILIO_AUTH_TOKEN is shared by two features and used differently by each:
#   - Outbound SMS (scripts/dispatch_notifications.py / dispatch-notifications.ts):
#     needs TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_FROM (a bare E.164
#     sender number, e.g. +61400000000 — NOT whatsapp:-prefixed; that prefix
#     is only meaningful for the WhatsApp channel).
#   - Inbound WhatsApp (/api/ingest/whatsapp): only needs TWILIO_AUTH_TOKEN, to
#     verify the X-Twilio-Signature header. Fails closed (503) in production
#     when unset.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=+61400000000

# Comma-separated allowlist of sender numbers permitted to write into
# vendor-facing feeds via WhatsApp, as BARE E.164 numbers (e.g. +61400000000)
# — the route strips Twilio's "whatsapp:" channel prefix from the inbound
# `From` field before comparing, so list plain numbers here, not prefixed
# ones. A WhatsApp business number is public, so signature verification
# alone (which only proves Twilio sent the request) isn't enough to
# establish who did.
WHATSAPP_ALLOWED_SENDERS=+61400000000,+61400000001

# ─── everypropertyai (comparable sales / suburb enrichment) ──────────────────

# Bearer key + base URL for the everypropertyai backend, used by
# /api/local-market and the agent-gated /api/agent/enrich/[slug] route.
# Fails soft to empty results when unset (report/enrichment still render).
EVERYPROPERTY_API_URL=https://geaeverypropertyai-production.up.railway.app
EVERYPROPERTY_API_KEY=your-everypropertyai-api-key

# ─── GEA CRM Read API ────────────────────────────────────────────────────────

# The weekly report pulls property, portal stats, and inspection data from the
# GEA_crmAI read API (the CRM owns the VaultRE/portal integrations — this app no
# longer talks to VaultRE directly). The same key also authorises the one write
# this app makes: recording a sent-report on approve/send (POST
# /api/report/sent-reports). Server-side only; never expose to the browser.
CRM_API_BASE_URL=https://your-gea-crm-deployment
WEEKLY_REPORT_API_TOKEN=your-weekly-report-consumer-token

# ─── MiniMax AI (optional) ───────────────────────────────────────────────────

# MiniMax API key — used by the AI commentary and market news draft features.
# Server-side only key (never expose to the browser).
MINIMAX_API_KEY=your-minimax-api-key

# Public MiniMax key if a client-side feature requires it (avoid if possible).
# NEXT_PUBLIC_MINIMAX_API_KEY=your-minimax-public-api-key
